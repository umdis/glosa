# Copiar a .env para desarrollo local. Nunca commitear valores reales.

# Carpeta con la base de datos y los medios (en el contenedor: /data, montado como volumen).
DATA_DIR=./data

# Clave de la Meta Model API (tier Standard). Solo en el servidor.
MODEL_API_KEY=

# Clave de administrador para subir videos, revisar pendientes y borrar contenido.
ADMIN_TOKEN=

# Tope de gasto diario de la demo, en dólares.
DAILY_SPEND_CAP_USD=5
